# Copy to .env, then fill KOPIA_SERVER_FINGERPRINT from the server:
# docker compose -f ../../server/docker-compose.yml exec server cat /repo/certs/fingerprint
# (Robot does this automatically when running test/kopia.robot.)

PROJECT_NAME=test-cluster

# Must match the server cluster releases.
KOPIA_VERSION=0.22.1
DOCKER_GEN_VERSION=0.17.2
YQ_VERSION=v4.44.3
SUPERCRONIC_VERSION=v0.2.51
SUPERCRONIC_SHA1SUM=1692066e350a88ff4d7d6474fe3c7a6c41ec5e89

# Identity of this cluster at the server: kopia user root@<host>.
KOPIA_CLIENT_HOST=test-cluster

# --- kopia server connection ---
KOPIA_SERVER_URL=https://server:51515
KOPIA_SERVER_FINGERPRINT=replace-me-with-server-fingerprint
KOPIA_CLIENT_PASSWORD=dev-client-password
