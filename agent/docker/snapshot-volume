#!/bin/sh
# One-shot snapshot trigger, called by supercronic with the volume and its
# retention on the command line (see templates/crontab.tmpl). Applies the
# kopia retention policy first — labels are the source of truth, absent
# knobs arrive as inherit so removal resets instead of going stale — then
# snapshots. Skips cleanly when the volume is not mounted.
# Usage: snapshot-volume --volume <name> [--keep-<unit>=<N|inherit> ...]
set -eu

vol= keeps=
while [ $# -gt 0 ]; do
  case $1 in
    --volume) vol=${2:?--volume needs a value}; shift 2 ;;
    --volume=*) vol=${1#--volume=}; shift ;;
    --keep-latest=* | --keep-hourly=* | --keep-daily=* | --keep-weekly=* | --keep-monthly=* | --keep-annual=*)
      opt=${1%%=*} val=${1#*=}
      case $val in inherit) ;;
        '' | *[!0-9]*) echo "snapshot-volume: $opt needs a count or inherit" >&2; exit 2 ;;
      esac
      keeps="$keeps $opt=$val"; shift ;;
    -h | --help) echo "Usage: snapshot-volume --volume <name> [--keep-<unit>=<N|inherit> ...]"; exit 0 ;;
    *) echo "snapshot-volume: unknown argument: $1" >&2; exit 2 ;;
  esac
done
if [ -z "$vol" ]; then echo "snapshot-volume: --volume is required" >&2; exit 2; fi

if [ ! -d "/mnt/$vol" ]; then
  echo "[agent] skip $vol (not mounted at /mnt/$vol)"
  exit 0
fi
# Jobs inherit the entrypoint environment, but stay self-sufficient for
# manual `docker compose exec` runs via the persisted password file.
KOPIA_PASSWORD=${KOPIA_PASSWORD:-$(cat /etc/backup-agent/repo-password)}
export KOPIA_PASSWORD
if [ -n "$keeps" ]; then
  # Unquoted split is safe: options are whitelisted above and values are
  # counts or the literal inherit.
  # shellcheck disable=SC2086
  kopia policy set $keeps "/mnt/$vol" >/dev/null \
    || { echo "[agent] policy failed for $vol" >&2; exit 1; }
fi
kopia snapshot create "/mnt/$vol" >/dev/null \
  && echo "[agent] snapshotted $vol"
