# Test fixture for the robot suite (test/kopia.robot): spins up the server
# cluster with a local volume — never NFS. Tracked with dev-only values;
# change only to evolve the test fixture, never for real deployments.
# (Deployments use the hidden, untracked `.env` instead.)
COMPOSE_FILE=docker-compose.yml

# Isolated from any deployed server stack on this host: own containers,
# own images, own `kopia-repo` volume. The shared `kopia-backup` network
# keeps its exact name so the test client cluster can join it.
PROJECT_NAME=kopia-server-test

BASE_DOMAIN=example.com
NGINX_PROXY_NETWORK=web-proxy

# Must match test/cluster/env.example.
KOPIA_VERSION=0.22.1

# --- server ---
KOPIA_REPOSITORY_PASSWORD=dev-repo-password
KOPIA_SERVER_USER=kopia
KOPIA_SERVER_PASSWORD=dev-server-password
KOPIA_GEN_SELF_SIGNED_CERT=false

# --- provisioned client ---
# Must match test/cluster/env.example (the suite's client identity).
KOPIA_CLIENT_USER=root
KOPIA_CLIENT_HOST=test-cluster
KOPIA_CLIENT_PASSWORD=dev-client-password
