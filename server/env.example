# Copy to .env and edit accordingly before starting the server cluster.
# Starts first: it owns the shared `kopia-backup` network that every
# client cluster joins as external. Start the nginx-proxy cluster before
# this one so the `web-proxy` network exists.

# Which compose files to load. Default is the base file (local volume).
# For an NFS-backed repository, load the overlay too:
# COMPOSE_FILE=docker-compose.yml:docker-compose.nfs.yml
COMPOSE_FILE=docker-compose.yml

PROJECT_NAME=kopia-server

# Domain for the server UI hostname (kopia.<domain>). Changing this moves
# VIRTUAL_HOST, ACME_HOST, and the Homepage href together.
BASE_DOMAIN=example.com
# Proxy network owned by the nginx-proxy cluster (its NGINX_PROXY_NETWORK).
NGINX_PROXY_NETWORK=web-proxy

# Upstream kopia release for the server image.
KOPIA_VERSION=0.22.1

# --- server ---
# Password encrypting the repository itself. Guard it like a secret.
KOPIA_REPOSITORY_PASSWORD=change-me
# HTTP basic-auth + control credentials for the server UI/API.
KOPIA_SERVER_USER=kopia
KOPIA_SERVER_PASSWORD=change-me-too

# --- proxy (server UI) ---
# Self-signed opt-in for LAN deployments or local testing; internet-facing
# deployments use ACME_HOST with the proxy companion. Defaults to false.
KOPIA_GEN_SELF_SIGNED_CERT=false

# --- provisioned client ---
# One conduit identity per client cluster, as kopia `user@host`.
# The sidecar reaches the server with these plus the repo password flow
# below; rotate by changing the password and recreating the user server-side.
KOPIA_CLIENT_USER=root
KOPIA_CLIENT_HOST=test-cluster
KOPIA_CLIENT_PASSWORD=change-me-three

# --- nfs (only when COMPOSE_FILE includes docker-compose.nfs.yml) ---
# NFS server hosting the kopia repository export.
NFS_ADDR=nfs.example.com
# Exported path holding the repository.
NFS_PATH=/exports/kopia-repo
# Mount options (optional, default rw,nfsvers=4).
NFS_OPTS=rw,nfsvers=4
